# ---------------------------------------------------------------------------
# Supplier discovery scraper configuration.
# Copy to ".env" and edit. Every value can also be passed as a CLI flag,
# and CLI flags win over the .env file.
# ---------------------------------------------------------------------------

# What you are sourcing. Use the language of the target domain:
#   europages.de / wlw.de  -> "Schweissdienstleistungen"
#   europages.it           -> "servizi di saldatura"
#   europages.co.uk        -> "welding services"
KEYWORD=welding services

# Directory domain to search. Supported profiles: europages.*, wlw.de.
# Anything else falls back to the generic (heuristic) profile.
TARGET_DOMAIN=europages.co.uk

# How many search result pages to walk. Start small (3-5) for a test run.
MAX_PAGES=3

# Output CSV.
OUTPUT=vendors.csv

# Fetch engine: auto | requests | playwright
#   auto       -> try requests, fall back to Playwright if the page looks empty
#   requests   -> static HTML only (fast, polite, low footprint)
#   playwright -> full browser (needed for JS-rendered directories)
ENGINE=auto

# Politeness. Seconds between requests, randomised in this range.
DELAY_MIN=1.5
DELAY_MAX=2.5

# Refuse to fetch anything robots.txt disallows for our user agent.
# Leave this true. Setting it to false is your decision and your liability.
RESPECT_ROBOTS=true

# Optional: override the search URL pattern entirely.
# Must contain {keyword} and may contain {page}. Example:
# SEARCH_URL_TEMPLATE=https://www.europages.co.uk/companies/{page}/{keyword}.html
SEARCH_URL_TEMPLATE=

# Optional: Chromium binary for Playwright (needed on hosts with a pre-baked
# browser that does not match the pinned Playwright build).
PLAYWRIGHT_EXECUTABLE_PATH=

# Max profile pages to visit per run (0 = no cap). Safety valve.
MAX_PROFILES=0
